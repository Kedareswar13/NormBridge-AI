# Copy this file to .env (repo root) and fill in values. Never commit .env.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=normbridge
DB_USER=policy_user
DB_PASSWORD=change-me
# DATABASE_URL=postgresql://user:pass@host:5432/dbname   # overrides the DB_* values (e.g. Neon/Supabase)

# --- Ollama (local LLM + embeddings) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_OCR_MODEL=glm-ocr

# --- Answer generation provider ---
# ollama (default, fully local) | openai (any OpenAI-compatible API - use for free web deployment)
LLM_PROVIDER=ollama
# Groq free tier:   LLM_API_BASE=https://api.groq.com/openai/v1    LLM_API_MODEL=llama-3.1-8b-instant
# Gemini free tier: LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai  LLM_API_MODEL=gemini-2.0-flash
LLM_API_BASE=
LLM_API_KEY=
LLM_API_MODEL=
LLM_TIMEOUT=240

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
ENABLE_OTP_AUTH=false
# Only needed when ENABLE_OTP_AUTH=true (Gmail app password, never your real password)
SMTP_EMAIL=
SMTP_PASSWORD=

# --- Users ---
ALLOWED_EMAIL_DOMAIN=srmap.edu.in

# --- Server ---
PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=*

# --- OCR (all optional; text PDFs work with PyPDF2 alone) ---
OCR_ENABLE_GLM=true
OCR_ENABLE_TESSERACT=true
OCR_ENABLE_EASYOCR=true
# Windows examples:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\tools\poppler\Library\bin
GLM_OCR_MODEL_PATH=

# --- Speed & caching ---
# CPU_THREADS=8                 # default: all cores
MODEL_KEEP_ALIVE=60m
RERANK_TOP_K=3
PROMPT_CHUNK_WORDS=70
PROMPT_TOP_CHUNK_WORDS=220
# yes/no questions are routed to this bigger model (1.5B has a yes-bias); empty = no routing
YESNO_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=220
SEMANTIC_CACHE_THRESHOLD=0.92
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # ~2x faster re-ranking (downloads once from Hugging Face)

# --- RAG security ---
TENANT_ID=srmap
# STAFF_EMAILS=hod.cse@srmap.edu.in,registrar@srmap.edu.in   # users who may retrieve staff-only policies
# STAFF_EMAIL_REGEX=^[a-z]+\.[a-z]+@srmap\.edu\.in$
MAX_QUERY_CHARS=800
AUDIT_SALT=change-me
# signs login session tokens (identity for chat/policies). setup.ps1 generates it.
SESSION_SECRET=change-me
SESSION_TTL_HOURS=12
# AUTH_REQUIRED=false   # local demos only: trusts the email sent by the browser (role can be spoofed)

# --- Quality ---
# yes/no questions on a hosted API (LLM_PROVIDER=openai) go to this model, e.g. llama-3.3-70b-versatile on Groq
YESNO_API_MODEL=
# add a second policy to the answer when its cross-encoder score is within this margin of the best (0 = off)
MULTI_DOC_MARGIN=1.5
# target words per structure-aware chunk (re-ingest with scripts\ingest_policies.py --force after changing)
CHUNK_WORDS=200

# --- Observability ---
TRACE_RETENTION=2000
# export traces to Jaeger / Aspire / Grafana Tempo (needs: pip install opentelemetry-sdk opentelemetry-exporter-otlp)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=normbridge-api
